  "/orders/{id}": {
   "get": {
    "operationId": "getOrderCn",
    "summary": "获取订单详情",
    "parameters": [
     {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "orderNo": {
           "type": "string",
           "description": "订单编号"
          },
          "amount": {
           "type": "number"
          }
         }
        }
       }
      }
     },
     "default": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
